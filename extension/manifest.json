{
  "manifest_version": 3,
  "name": "网页伴随屏",
  "version": "0.5.1",
  "description": "把用户选择的 Edge 标签页画面发送到 HarmonyOS 原生接收端；不采集音频。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "http://harmony-web-companion.local/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "action": {
    "default_title": "发送当前标签页",
    "default_popup": "setup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
